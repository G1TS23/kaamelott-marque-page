---
/**
 * Coquille commune du site (issue #13).
 * Le site tient sur une seule page (specs section 6), mais le layout est
 * isolé dès maintenant : la popin de première visite (#19) et le pied de
 * page (#20) viendront s'y greffer sans toucher au contenu.
 *
 * Favicon et balises de partage (issue #79) : `favicon.svg` (ruban de
 * marque-page, même mécanique clair/sombre embarquée que l'ancien favicon
 * du gabarit Astro qu'il remplace) avec repli `favicon.ico`/
 * `apple-touch-icon.png`, tous trois dans `site/public/`, régénérés à
 * partir du même tracé. `description` (nouveau prop, valeur par défaut =
 * l'ancien texte fixe) alimente à la fois `<meta name="description">` et
 * les balises `og:*`/`twitter:*`.
 */
import '../styles/polices.css';
import '../styles/tokens.css';

const {
  titre = 'Kaamelott — Le Marque-Page de la Relecture',
  description = 'Retrouver un épisode de Kaamelott dans les lectures de Shisheyu et sauter directement au bon instant.',
} = Astro.props;

// URL absolues (issue #79) : og:image et og:url n'admettent pas de chemin
// relatif — `Astro.site` (astro.config.mjs) fournit le domaine de prod.
// `og-image.jpg` : issue #79, une seule image de partage pour tout le
// site plutôt qu'une par page (le contenu dynamique — épisode en cours —
// n'existe que côté client une fois l'îlot monté, jamais au moment où un
// crawler de réseau social récupère la page).
const urlCanonique = new URL(Astro.url.pathname, Astro.site);
const urlImagePartage = new URL('/og-image.jpg', Astro.site);

// Données structurées (issue 118, audit de stabilisation) : `WebSite`
// minimal, `url` = la racine du site (pas `urlCanonique`, qui varie par
// page — l'entité `WebSite` représente le site entier, pas une page
// précise). Volontairement sans `description`/`inLanguage` ni `Person`
// complet dupliqué : même forme que sur les autres petits sites de
// l'auteur (pont-chaban, boom-boom-boom, radiant-radiation), où seuls
// `name`/`url` pilotent le nom de site affiché par Google
// (developers.google.com/search/docs/appearance/site-names) — le
// `Person` détaillé (compétences, adresse...) reste propre au portfolio
// central (randomfolio).
//
// `author` minimal ajouté quand même (retour d'usage) : sans lui, rien
// ne relie ce site à l'auteur de façon structurée — les mentions légales
// le disent en texte, mais Google n'en tire rien. Volontairement réduit
// à `name`/`url` (vers le portfolio, l'entité `Person` complète avec
// `sameAs` GitHub/LinkedIn) plutôt que de redéclarer tout le `Person` ici.
const urlRacine = new URL('/', Astro.site);
const jsonLdSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Le Marque-Page de la Relecture',
  url: urlRacine,
  author: {
    '@type': 'Person',
    name: 'Olivier Falahi',
    url: 'https://olivier.falahi.org',
  },
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={urlCanonique} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!-- Propriété Search Console (issue 118). Ne pas retirer : Google
         revérifie la balise et révoque la propriété si elle disparaît. Le
         jeton est lié au compte Google, la même valeur valide donc les
         autres sites de l'auteur (pont-chaban, boom-boom-boom,
         radiant-radiation). -->
    <meta name="google-site-verification" content="EzLJyfi1es6usmPOdk846im38M2Z7Bx4dGT_Ul3FS2g" />

    <!-- Données structurées (schema.org/WebSite) : nom de site dans Google -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdSite)} is:inline />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Le Marque-Page de la Relecture" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urlCanonique} />
    <meta property="og:image" content={urlImagePartage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Le Marque-Page de la Relecture — Shisheyu lit Kaamelott" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titre} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImagePartage} />

    <title>{titre}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /*
   * Styles de base : ce que les tokens impliquent au niveau des éléments HTML.
   * Les valeurs elles-mêmes vivent dans src/styles/tokens.css (issue #51) —
   * rien ne doit être écrit en dur ici.
   */

  * {
    box-sizing: border-box;
  }

  /* Réserve la place de la scrollbar en permanence : sans ça, une page dont
     le contenu passe sous la hauteur de la fenêtre (résultat de recherche
     court, #15) perd sa scrollbar et tout le contenu centré glisse vers la
     droite pour récupérer cette largeur — un décalage visible à chaque
     frappe qui réduit la liste. */
  html {
    scrollbar-gutter: stable;
  }

  body {
    margin: 0;
    background: var(--fond);
    color: var(--encre);
    font-family: var(--police-texte);
    font-size: var(--taille-base);
    line-height: var(--interligne);
  }

  h1,
  h2,
  h3 {
    font-family: var(--police-titre);
    font-weight: 600;
    color: var(--encre);
    text-wrap: balance;
  }

  a {
    color: var(--profond);
  }

  /* Numéros d'épisode et minutages : chasse fixe et chiffres tabulaires, pour
     qu'une colonne de nombres s'aligne au lieu de danser d'une ligne à l'autre. */
  code,
  .mono {
    font-family: var(--police-mono);
    font-variant-numeric: tabular-nums;
  }

  ::selection {
    background: var(--accent-voile);
    color: var(--accent-fort);
  }
</style>
