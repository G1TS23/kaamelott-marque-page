---
/**
 * Mentions légales — obligation minimale même pour un site personnel non
 * professionnel (LCEN art. 6-III-1-a) : identité de l'éditeur (nom +
 * contact) et de l'hébergeur publiques. Domicile et téléphone ne sont pas
 * publiés (choix assumé, plus léger que la lettre stricte de la loi, mais
 * pratique courante pour un site personnel).
 *
 * Page statique, hors de l'îlot Site.svelte (specs section 6 : le site
 * applicatif tient sur une seule page, mais une page d'infos légales
 * séparée n'y déroge pas). `PiedDePage` est réutilisé tel quel, sans
 * `client:*` — aucune de ses props n'a besoin d'interactivité ici.
 *
 * Contenu dans `MentionsLegalesContenu.svelte` (issue #77), sans
 * `client:*` non plus — un composant Svelte sans directive se rend en
 * HTML pur au build, exactement comme du markup Astro, zéro JS expédié.
 * Partagé avec `PanneauMentionsLegales.svelte`, ouvert depuis le site
 * sans navigation (voir `Site.svelte`) pour ne pas relancer le lecteur
 * vidéo juste pour lire ce texte — cette page reste le point d'entrée
 * pour un accès direct ou un lien partagé.
 */
import Base from '../layouts/Base.astro';
import MentionsLegalesContenu from '../components/MentionsLegalesContenu.svelte';
import PiedDePage from '../components/PiedDePage.svelte';
---

<Base titre="Mentions légales — Le Marque-Page de la Relecture">
  <main>
    <p class="retour"><a href="/">&larr; Retour au site</a></p>

    <h1>Mentions légales</h1>

    <MentionsLegalesContenu />
  </main>

  <PiedDePage />
</Base>

<style>
  main {
    max-width: var(--largeur-contenu);
    margin: 0 auto;
    padding: var(--esp-6) var(--esp-4) calc(2.75rem + var(--esp-6));
  }

  /* Sous 640px (issue #74) : le pied de page passe sur deux lignes plutôt
     que de déborder (`PiedDePage.svelte`), 4rem mesuré/arrondi plutôt que
     2.75rem sur une ligne. */
  @media (max-width: 640px) {
    main {
      padding-bottom: calc(4rem + var(--esp-6));
    }
  }

  .retour {
    margin-bottom: var(--esp-4);
  }

  /* Soulignés en permanence, pas seulement au survol — même retour
     d'accessibilité que le pied de page (WCAG 1.4.1, la couleur seule ne
     suffit pas à distinguer un lien). Ne couvre plus que « Retour au
     site » : le style des h2/p/liens du contenu légal lui-même vit dans
     `MentionsLegalesContenu.svelte` (issue #77) — les styles scopés
     d'une page Astro ne s'appliquent pas au rendu d'un composant enfant. */
  main a {
    text-decoration: underline;
  }
</style>
