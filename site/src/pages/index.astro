---
import Base from '../layouts/Base.astro';
import Site from '../components/Site.svelte';
import { LIVRES, chargerLivre } from '../lib/episodes.ts';
import type { LivreEnListe } from '../lib/episodes.ts';

/**
 * Page unique du site (specs section 6 : un seul lecteur, pas de mur de
 * vignettes). Un seul îlot (`Site.svelte`) : le lecteur et le sélecteur de
 * livre partagent l'état de navigation, deux îlots séparés ne le pourraient
 * pas sans mécanisme de partage à part entière (issue #14).
 */

// Seuls les champs utiles à la liste sont passés à l'îlot : les résumés
// (~300 Ko au total) n'y entrent que quand la recherche en aura besoin
// (#15/#16), pour ne pas les sérialiser inutilement dans le HTML.
const livres: LivreEnListe[] = LIVRES.map((livre) => ({
  livre,
  episodes: chargerLivre(livre).map(({ episode, title, start_seconds, video_id }) => ({
    episode,
    title,
    start_seconds,
    video_id,
  })),
}));

const total = livres.reduce((n, l) => n + l.episodes.length, 0);
---

<Base>
  <main>
    <header>
      <h1>Le Marque-Page de la Relecture</h1>
      <p class="sous-titre">
        Les {total} épisodes de Kaamelott, situés dans les lectures de Shisheyu.
      </p>
    </header>

    <Site client:load livres={livres} />
  </main>
</Base>

<style>
  main {
    max-width: var(--largeur-contenu);
    margin: 0 auto;
    padding: var(--esp-5) var(--esp-4) var(--esp-6);
  }

  h1 {
    margin: 0 0 var(--esp-1);
    font-size: 2rem;
    line-height: 1.1;
  }

  .sous-titre {
    margin: 0 0 var(--esp-5);
    color: var(--encre-douce);
  }
</style>
