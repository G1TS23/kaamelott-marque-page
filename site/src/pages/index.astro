---
import Base from '../layouts/Base.astro';
import Site from '../components/Site.svelte';
import PopinBienvenue from '../components/PopinBienvenue.svelte';
import { LIVRES, chargerLivre } from '../lib/episodes.ts';
import type { LivreEnListe } from '../lib/episodes.ts';

/**
 * Page unique du site (specs section 6 : un seul lecteur, pas de mur de
 * vignettes). Un seul îlot pour le lecteur et le sommaire (`Site.svelte`) :
 * ils partagent l'état de navigation, deux îlots séparés ne le pourraient
 * pas sans mécanisme de partage à part entière (issue #14). `PopinBienvenue`
 * est un second îlot à part, sans aucun état à partager avec le premier
 * (issue #19).
 */

// Seuls les champs utiles à la liste sont passés à l'îlot : les résumés
// (~300 Ko au total) n'y entrent que quand la recherche en aura besoin
// (#15/#16) — chargés à part via /recherche.json, pas ici. `id` sert de clé
// pour recoller les deux plus tard (site/src/lib/recherche.ts).
const livres: LivreEnListe[] = LIVRES.map((livre) => ({
  livre,
  episodes: chargerLivre(livre).map(({ id, episode, title, start_seconds, video_id }) => ({
    id,
    episode,
    title,
    start_seconds,
    video_id,
  })),
}));
---

<Base>
  <main>
    <Site client:load livres={livres} />
  </main>
  <PopinBienvenue client:load />
</Base>

<style>
  main {
    max-width: var(--largeur-contenu);
    margin: 0 auto;
    /* Le haut compense la hauteur de l'en-tête collée (Site.svelte,
       `position: fixed` — issue #54), qui a remplacé le grand titre qui
       vivait ici : sans cette marge, l'en-tête recouvrirait le début du
       contenu. */
    /* Le bas compense la hauteur du pied de page fixe (Site.svelte,
       `PiedDePage.svelte` — issue #20), qui sinon recouvrirait la fin du
       sommaire. */
    padding: calc(3rem + var(--esp-4)) var(--esp-4) calc(2.75rem + var(--esp-4));
  }
</style>
